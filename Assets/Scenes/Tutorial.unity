  m_Script: {fileID: 11500000, guid: 74c2bf8752e630b49bbfdb63baa955aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialController
  dialogueTextBox: {fileID: 188390242}
  dialogueBox: {fileID: 63506024}
  chalkboardViewPoint: {fileID: 1948846037}
  kneadViewPoint: {fileID: 64519411}
  kneadCanvas: {fileID: 422854460}
  kneadStage: {fileID: 721335667}
  shapeStage: {fileID: 1333395443}
  breadBaker: {fileID: 2106040945}
  chef: {fileID: 809566383}
  chefBakingPosition: {fileID: 321263270}
  chefShapingPosition: {fileID: 506143443}
  chefBowlingPosition: {fileID: 438911125}
  returnToKneadButton: {fileID: 1024120106}
  bakeButton: {fileID: 1166938836}
  bowlButton: {fileID: 10246546}
  currentStageInd: 0
  currentStage: Kneading
  dialogue:
  - 'Hello Chef! I am your Head Chef ___ and today is your first day at Upper Crust
    Academy! We have very high standards here, and we want to start you rolling down
    the right path. Today''s lesson starts with some simple breadmaking. In front
    of you lies your dough. Bask in its beauty. '
  - Look to the chalkboard and you'll see what tools are available to you. The highlighted
    keys are what you'll be using for the kneading. Hold space bar, and gently roll
    you hands over the keys. To spin your dough, use the left and right shift keys.
    An important step is folding your dough, press any 3 number keys to fold.
  - Now that you've gotten a feel for kneading, I'll let you in a little trick on
    telling how kneaded your dough is. Select "BakerVision" at the top left, and
    you'll see your dough turn beautiful colours. Underknead your dough, and it'll
    stay red and won't rise. Overknead your dough, and it'll turn purple and rise
    unpredictably. Find your own sweet spot!
  - Next, you can choose to shape your bread into a traditional boule shape, or go
    for the long and lean baguette!
  - Using our SuperOven9000, bake your bread and watch it rise! Take it out too early
    and you'll end up with a sticky flat loaf. Take it out too late, and you'll end
    up with a smooth crusty dusty loaf. Better keep an eye on it!
  - Your bread turned out terribly! No one will want to eat this disgusting lump
    of gluten. The only thing it would be good for is throwing it out!
  - Use the arrows on the left to move your bread ball left and right. Use the arrows
    on the right to rotate your bread ball. Press Launch to send your bread flying!
  duration: 1
